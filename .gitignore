# =============================================================================
# The Content Forge — .gitignore
# =============================================================================

# Generated output (one folder per pipeline run)
output/*/
!output/.gitkeep

# Member config — personal/private, generated by /setup
config/member-profile.md

# Secrets
.env
.env.*
!.env.example
!examples/.env.example.populated
*.env

# Build journal (personal notes)
build-journal/

# Local Claude Code session state
.swarm/
.sandbox-*/
.claw/
agentdb.rvf*
ruvector.db

# Cookies / browser state
substack/cookies.txt
.camofox/
*.cookies.txt

# OS / editor
.DS_Store
Thumbs.db
*.swp
*~

# Node / Python
node_modules/
dist/
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.pytest_cache/

# Generated images in Slidev scaffold (regenerated per project)
harness-templates/presentations/public/images/*.png
!harness-templates/presentations/public/images/.gitkeep

# Remotion render output
tools/broll-animator/out/
tools/broll-animator/public/*.png
!tools/broll-animator/public/.gitkeep

# Transcription temp files
*.tmp.wav
*.tmp.mp3
