# =============================================================================
# Illustrative populated .env (fake values — do NOT use as-is)
# =============================================================================
# This shows what a fully-wired-up project looks like. All values below are
# fake/illustrative — replace with your own real credentials in `.env`.
# =============================================================================

PROJECT_NAME=My Course Platform
DEFAULT_CREATOR_HANDLE=@yourhandle
DEFAULT_RECIPIENT_EMAIL=you@example.com
BUILD_JOURNAL_PATH=./build-journal

# Venice AI
VENICE_API_KEY=vai_fake_1234567890abcdef
VENICE_IMAGE_MODEL=nano-banana-pro
VENICE_LLM_MODEL=claude-opus-4-6

# Mailgun
MAILGUN_API_KEY=key-fake1234567890abcdef
MAILGUN_DOMAIN=mg.example.com
EMAIL_FROM=you@example.com
EMAIL_CC=team@example.com
EMAIL_YT_STRATEGIST=strategist@example.com
EMAIL_VIDEO_EDITOR=editor@example.com

# Telegram
TELEGRAM_BOT_TOKEN=0000000000:ABC_fake_token_xyz
TELEGRAM_TWEETS_ID=000000000
TELEGRAM_NOTIFICATIONS_GROUP_ID=-1000000000000

# LinkedIn
LINKEDIN_ACCESS_TOKEN=fake_access_token
LINKEDIN_PERSON_URN=urn:li:person:fakeid
LINKEDIN_CLIENT_ID=fake_client_id
LINKEDIN_CLIENT_SECRET=fake_client_secret
LINKEDIN_REFRESH_TOKEN=fake_refresh_token

# Kit / ConvertKit
KIT_API_KEY=fake_kit_key
KIT_EMAIL_TEMPLATE_ID=1234567

# Substack
SUBSTACK_EMAIL=you@example.com
SUBSTACK_PASSWORD=fake_password
SUBSTACK_PUBLICATION_URL=https://yourname.substack.com
SUBSTACK_COOKIES_PATH=substack/cookies.txt

# Skool (via Camofox)
CAMOFOX_API_KEY=fake_camofox_key
SKOOL_COURSE_URL=https://www.skool.com/your-community/classroom/your-course-id

# Google Drive
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./secrets/google-service-account.json
GOOGLE_DRIVE_FOLDER_ID=1ABC_fake_folder_id

# Subtitles
SUBTITLE_FONT_PATH=/System/Library/Fonts/Supplemental/Arial.ttf
