# =============================================================================
# The Content Forge — Environment Configuration
# =============================================================================
# All variables are OPTIONAL. Each integration is independently feature-flagged.
# If a credential is missing, that integration is gracefully skipped at runtime.
#
# Copy this file: cp .env.example .env
# Then fill in the integrations you want to use.
# =============================================================================


# -----------------------------------------------------------------------------
# Project Identity (recommended)
# -----------------------------------------------------------------------------
PROJECT_NAME=
DEFAULT_CREATOR_HANDLE=
DEFAULT_RECIPIENT_EMAIL=

# Where to write build-journal entries (one file per day, YYYY-MM-DD.md)
BUILD_JOURNAL_PATH=./build-journal


# -----------------------------------------------------------------------------
# Venice AI (image generation — required for hero images + storyboard art)
# https://venice.ai/api
# -----------------------------------------------------------------------------
VENICE_API_KEY=
VENICE_IMAGE_MODEL=nano-banana-pro
VENICE_LLM_MODEL=
# VENICE_API_BASE_URL=https://api.venice.ai/api/v1


# -----------------------------------------------------------------------------
# Mailgun (email delivery — optional, used by /repurpose-social)
# https://mailgun.com
# -----------------------------------------------------------------------------
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
EMAIL_FROM=
EMAIL_CC=
EMAIL_YT_STRATEGIST=
EMAIL_VIDEO_EDITOR=


# -----------------------------------------------------------------------------
# Telegram (notifications — optional, used by /repurpose-social)
# Create a bot via @BotFather, then /start it from the target chats.
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_TWEETS_ID=
TELEGRAM_NOTIFICATIONS_GROUP_ID=


# -----------------------------------------------------------------------------
# LinkedIn (draft posting — optional)
# Run: python3 scripts/linkedin-setup.py for interactive OAuth setup
# -----------------------------------------------------------------------------
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REFRESH_TOKEN=


# -----------------------------------------------------------------------------
# Kit / ConvertKit (newsletter drafts — optional)
# https://kit.com — API key at: Settings > Advanced > API
# -----------------------------------------------------------------------------
KIT_API_KEY=
KIT_EMAIL_TEMPLATE_ID=


# -----------------------------------------------------------------------------
# Substack (blog draft posting — optional, uses cookie auth)
# Drop session cookies into substack/cookies.txt
# -----------------------------------------------------------------------------
SUBSTACK_EMAIL=
SUBSTACK_PASSWORD=
SUBSTACK_PUBLICATION_URL=
SUBSTACK_COOKIES_PATH=substack/cookies.txt


# -----------------------------------------------------------------------------
# Skool (course publishing — optional, requires Camofox local browser)
# https://skool.com — Camofox is a separate browser automation tool
# -----------------------------------------------------------------------------
CAMOFOX_API_KEY=
SKOOL_COURSE_URL=


# -----------------------------------------------------------------------------
# Google Drive (file uploads — optional)
# -----------------------------------------------------------------------------
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=
GOOGLE_DRIVE_FOLDER_ID=


# -----------------------------------------------------------------------------
# Subtitle rendering (ffmpeg subtitle burn-in for clips)
# Path to a .ttf or .otf font file used for burned-in subtitles
# -----------------------------------------------------------------------------
SUBTITLE_FONT_PATH=
